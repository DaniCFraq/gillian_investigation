predicate is_int(+a: Int) {
    emp
}

{ (a == #a) * is_int(a) * (b == #b) * is_int(b) * (c == #c) * is_int(c) }
function main(a, b, c) {
    r1 := a * (b + c);
    r2 := (a * b) + (a * c);

    r3 := a * (b - c);
    r4 := (a * b) - (a * c);

    r := new(2);
    [r] := r1 == r2;
    [r + 1] := r3 == r4;
    
    return r
}
{ (ret -> true, true) }