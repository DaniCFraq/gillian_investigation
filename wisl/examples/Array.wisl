predicate list(+x, alpha : List) {
    (x == null) * (alpha == nil);
    (x -> #s, #c, #b) * (#s <= #c) * (#c == len(#b)) * (#s == len(alpha)) * (#b == (alpha @ #beta))
}

{ (#x == x) * list(#x, #alpha) }
function llen(x) {
  if (x == null) {
    n := 0
  } else {
    n := [x]
  };
  return n
}
{ list(#x, #alpha) * (ret == len(#alpha)) }
