predicate is_int(a: Int) {
    emp
}

{ (x == #x) * is_int(x) }
function test_neutral(x) {
    r1 := x + 0;
    r2 := 0 + x;
    r3 := x * 1;
    r4 := 1 * x;
    r5 := x - 0;

    r := new(5);
    [r]     := r1 == x;
    [r + 1] := r2 == x;
    [r + 2] := r3 == x;
    [r + 3] := r4 == x;
    [r + 4] := r5 == x;

    return r
}
{ (ret -> true, true, true, true, true) }
